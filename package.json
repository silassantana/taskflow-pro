{
  "name": "taskflow-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite client --config client/vite.config.mjs",
    "dev:server": "npm -w server run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -p client/tsconfig.json && vite build client --config client/vite.config.mjs",
    "build:server": "npm -w server run build",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "axios": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/jest": "^29.5.4",
    "@vitejs/plugin-react": "^5.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
